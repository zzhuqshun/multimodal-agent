{
  "$defs": {
    "AnnotationProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "method": {
          "enum": [
            "handcrafted",
            "synthetic_generator",
            "human"
          ],
          "title": "Method",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "independently_reviewed": {
          "title": "Independently Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "version",
        "independently_reviewed"
      ],
      "title": "AnnotationProvenance",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "boolean",
          "default": "boolean",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "CellLocator": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "cell",
          "default": "cell",
          "title": "Kind",
          "type": "string"
        },
        "sheet": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sheet",
          "type": "string"
        },
        "cell_range": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cell Range",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "cell_range"
      ],
      "title": "CellLocator",
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "date",
          "default": "date",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "format": "date",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DecimalValue": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "decimal",
          "default": "decimal",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "DecimalValue",
      "type": "object"
    },
    "ExpectedCalculation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule Version",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ExpectedCandidate"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "expected_value": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanValue",
              "date": "#/$defs/DateValue",
              "decimal": "#/$defs/DecimalValue",
              "integer": "#/$defs/IntegerValue",
              "text": "#/$defs/TextValue",
              "text_list": "#/$defs/TextListValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/IntegerValue"
            },
            {
              "$ref": "#/$defs/DecimalValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/TextListValue"
            }
          ],
          "title": "Expected Value"
        },
        "unit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "inputs",
        "expected_value",
        "unit"
      ],
      "title": "ExpectedCalculation",
      "type": "object"
    },
    "ExpectedCandidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanValue",
              "date": "#/$defs/DateValue",
              "decimal": "#/$defs/DecimalValue",
              "integer": "#/$defs/IntegerValue",
              "text": "#/$defs/TextValue",
              "text_list": "#/$defs/TextListValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/IntegerValue"
            },
            {
              "$ref": "#/$defs/DecimalValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/TextListValue"
            }
          ],
          "title": "Value"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "ExpectedCandidate",
      "type": "object"
    },
    "ExpectedField": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "gold_field_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Gold Field Id",
          "type": "string"
        },
        "accepted_values": {
          "items": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "boolean": "#/$defs/BooleanValue",
                    "date": "#/$defs/DateValue",
                    "decimal": "#/$defs/DecimalValue",
                    "integer": "#/$defs/IntegerValue",
                    "text": "#/$defs/TextValue",
                    "text_list": "#/$defs/TextListValue"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/TextValue"
                  },
                  {
                    "$ref": "#/$defs/DateValue"
                  },
                  {
                    "$ref": "#/$defs/IntegerValue"
                  },
                  {
                    "$ref": "#/$defs/DecimalValue"
                  },
                  {
                    "$ref": "#/$defs/BooleanValue"
                  },
                  {
                    "$ref": "#/$defs/TextListValue"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1,
          "title": "Accepted Values",
          "type": "array"
        },
        "expected_status": {
          "enum": [
            "verified",
            "conflict",
            "missing",
            "review_required",
            "needs_calculation",
            "not_applicable"
          ],
          "title": "Expected Status",
          "type": "string"
        },
        "expected_action": {
          "enum": [
            "fill",
            "request_documents",
            "request_confirmation",
            "calculate",
            "leave_blank"
          ],
          "title": "Expected Action",
          "type": "string"
        },
        "expected_candidates": {
          "items": {
            "$ref": "#/$defs/ExpectedCandidate"
          },
          "title": "Expected Candidates",
          "type": "array"
        },
        "evidence_alternatives": {
          "items": {
            "items": {
              "$ref": "#/$defs/GoldEvidence"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": "Evidence Alternatives",
          "type": "array"
        },
        "expected_issue_codes": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Expected Issue Codes",
          "type": "array"
        },
        "expected_calculation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectedCalculation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "gold_field_id",
        "accepted_values",
        "expected_status",
        "expected_action"
      ],
      "title": "ExpectedField",
      "type": "object"
    },
