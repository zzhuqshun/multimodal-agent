            },
            {
              "$ref": "#/$defs/WordCellLocator"
            }
          ],
          "title": "Locator"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "locator",
        "quote",
        "start",
        "end"
      ],
      "title": "GoldEvidence",
      "type": "object"
    },
    "IntegerValue": {
