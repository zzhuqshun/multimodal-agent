    "GoldEvidence": {
      "additionalProperties": false,
      "description": "Independent source anchor; never references prediction-generated IDs.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
