{
  "$defs": {
    "BusinessRule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "format",
            "consistency",
            "date_days_inclusive"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "version",
        "kind",
        "description"
      ],
      "title": "BusinessRule",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Document Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "target_form",
            "reference"
          ],
          "title": "Role",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "document_type": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Type"
        }
      },
      "required": [
        "document_id",
        "role",
        "media_type",
        "relative_path",
        "sha256",
        "synthetic"
      ],
      "title": "Document",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Description",
      "type": "string"
    },
    "target_document_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Target Document Id",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/Document"
      },
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "ruleset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Ruleset Id",
      "type": "string"
    },
    "ruleset_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Ruleset Version",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/BusinessRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "as_of_date": {
      "format": "date",
      "title": "As Of Date",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "description",
    "target_document_id",
    "documents",
    "ruleset_id",
    "ruleset_version",
    "as_of_date"
  ],
  "title": "TaskInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smartfill:0.1.0:TaskInput"
}
